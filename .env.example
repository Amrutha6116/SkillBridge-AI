# SkillBridge AI Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Flask App Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
# Default: Local SQLite (zero setup required for local development and vivas)
DATABASE_URL=sqlite:///instance/skillbridge.db

# For MySQL in production or advanced setup:
# DATABASE_URL=mysql+pymysql://db_user:db_password@localhost:3306/skillbridge_ai

# Security & Provisioning
# Secret token required to register an Administrator account
ADMIN_SECRET_KEY=skillbridge-admin-secret-2026

# AI Recommendation Service (Optional)
# If provided, the system queries Google Gemini API for personalized recommendations
# If empty or invalid, the system automatically uses the intelligent deterministic fallback
GEMINI_API_KEY=

